# Viviendha Environment Configuration Example
# Copy this file to .env or .env.local for local development or set in your Vercel Project Settings.
# NEVER commit real API keys or sensitive secrets to version control.

# Email Service Provider (Optional - defaults to serverless logging if not set)
RESEND_API_KEY=your_resend_api_key_here

# Notification Configuration
NOTIFICATION_EMAIL=satya@viviendhadevelopers.com
SENDER_EMAIL=notifications@viviendha.com

# Admin Authentication (Server-only credentials - NEVER exposed to frontend)
ADMIN_EMAIL=admin@viviendha.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_JWT_SECRET=your_super_secret_jwt_random_key_here
